{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cardwave",
  "identifier": "cc.cardwave.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyQjIxN0M0QjNCOUFGRDMKUldUVHI3bXp4QmV5d2xGa2RpbTNMV3lNTmFoZVh4aTJoTG4xSUVlMFY0cCtiRGppbVVFUVQyRjIK",
      "endpoints": ["https://github.com/elana-voss/cardwave/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../web/dist/": "web/", "llama/": "llama/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/sidebar.bmp",
        "headerImage": "icons/header.bmp",
        "installerHooks": "installer.nsh",
        "languages": ["English", "Spanish", "PortugueseBR", "Russian", "Japanese", "Korean", "Vietnamese", "SimpChinese", "TradChinese", "German"]
      }
    }
  }
}

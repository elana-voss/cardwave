### UI के शब्द हिंदी में: सर्वर के एरर जवाब, api/generated/Code.ts (errors.ts) के हर कोड के लिए एक,
### `error-<code>`, "_" की जगह "-"; शब्द-सूची hi.ftl के शुरू में है।

## अनुरोध, जैसा सर्वर ने उसे लिया

error-request-failed = यह नहीं हो सका। फिर से कोशिश करें।
error-internal = Cardwave में कुछ गड़बड़ हो गई। फिर से कोशिश करें।
error-bad-request = Cardwave यह अनुरोध पढ़ नहीं सका। पेज फिर से लोड करें और दोबारा कोशिश करें।
error-forbidden = इसकी अनुमति नहीं है।
error-no-such-path = Cardwave में ऐसा कोई पेज नहीं है। पेज फिर से लोड करें और दोबारा कोशिश करें।
error-method-not-allowed = Cardwave यहाँ यह नहीं करता। पेज फिर से लोड करें और दोबारा कोशिश करें।
error-too-large = यह बहुत बड़ा है। कोई छोटी फ़ाइल आज़माएँ।
error-unsupported-type = Cardwave यहाँ इस तरह की फ़ाइल नहीं लेता।

## पासवर्ड और अकाउंट

error-locked = पासवर्ड दिए जाने तक Cardwave लॉक है।
error-sign-in = पहले साइन इन करें।
error-password-wrong = गलत पासवर्ड।
error-password-needed = पासवर्ड चाहिए।
error-current-password-needed = मौजूदा पासवर्ड चाहिए।
error-backup-password-needed = इस बैकअप के लिए उसका पासवर्ड चाहिए।
error-too-many-tries = बहुत बार गलत पासवर्ड। { $seconds } सेकंड बाद फिर से कोशिश करें।
error-owner-only = { $action ->
    [use_its_files] इसकी फ़ाइलें इस्तेमाल करने
    [use_its_folders] इसके फ़ोल्डर इस्तेमाल करने
    [choose_its_models] इसके मॉडल चुनने
    [lock_Cardwave] Cardwave लॉक करने
   *[other] ऐसा करने
} की अनुमति सिर्फ़ इस कंप्यूटर के अकाउंट को है।
error-no-password-to-lock = Cardwave सिर्फ़ तभी लॉक होता है जब पासवर्ड चालू हो।
error-remote-sign-in-off = यह अकाउंट किसी दूसरे डिवाइस से साइन इन नहीं कर सकता। इसे अकाउंट › शेयरिंग में चालू करें।
error-no-password-on = कोई पासवर्ड चालू नहीं है।
error-no-password-set = इस अकाउंट के लिए कोई पासवर्ड सेट नहीं है।
error-password-kept = इस कंप्यूटर के एक अकाउंट का पासवर्ड है: वह उसी से साइन इन करता है।
error-account-busy = Cardwave अभी जवाब लिख रहा है या किरदार पढ़ रहा है; उसके पूरा होने पर फिर से कोशिश करें।
error-restore-busy = Cardwave अभी जवाब लिख रहा है या किरदार पढ़ रहा है; उसके पूरा होने पर फिर से कोशिश करें।
error-backup-needs-password = बैकअप के लिए पासवर्ड चाहिए।

## जिसके बारे में पूछा गया

error-not-found = { $what ->
    [account] ऐसा कोई अकाउंट
    [asset] कार्ड में ऐसी कोई फ़ाइल
    [attachment] ऐसा कोई अटैचमेंट
    [card] ऐसा कोई कार्ड
    [card_version] ऐसा कोई कार्ड वर्ज़न
    [chat] ऐसी कोई चैट
    [chat_character] चैट में ऐसा कोई किरदार
    [checkpoint] ऐसा कोई चेकपॉइंट
    [deleted_message] ऐसा कोई हटाया गया मैसेज
    [document] ऐसा कोई डॉक्यूमेंट
    [expression] ऐसा कोई एक्सप्रेशन
    [expression_pack] एक्सप्रेशन सेट
    [figure] ऐसा कोई फ़िगर
    [kind_of_model] मॉडल का ऐसा कोई प्रकार
    [language] ऐसी कोई भाषा
    [lorebook] ऐसी कोई लोरबुक
    [lorebook_entry] ऐसी कोई लोरबुक एंट्री
    [memory] ऐसी कोई याद
    [message] ऐसा कोई मैसेज
    [model] ऐसा कोई मॉडल
    [persona] ऐसा कोई पर्सोना
    [picture] ऐसी कोई तस्वीर
    [preset] ऐसा कोई प्रीसेट
    [prompt_preset] ऐसा कोई प्रॉम्प्ट प्रीसेट
    [provider] ऐसा कोई प्रोवाइडर
    [question] ऐसा कोई सवाल
    [task] ऐसा कोई टास्क
    [tool] ऐसा कोई टूल
    [user] ऐसा कोई अकाउंट
    [voice] ऐसी कोई आवाज़
   *[other] ऐसी कोई चीज़
} नहीं है। हो सकता है उसे मिटा दिया गया हो।
error-chat-busy = इस चैट में एक जवाब लिखा जा रहा है; पहले उसे रोकें।
error-no-provider = अभी कोई प्रोवाइडर सेट अप नहीं है। सेटिंग्स › प्रोवाइडर में एक जोड़ें।
error-provider-refused = { $refusal ->
    [key] प्रोवाइडर ने की नहीं मानी: इसे सेटिंग्स › प्रोवाइडर में जाँचें।
    [busy] प्रोवाइडर के पास क्रेडिट नहीं बचा या वह व्यस्त है: बाद में फिर कोशिश करें।
    [down] प्रोवाइडर जवाब नहीं दे रहा: बाद में फिर कोशिश करें।
   *[other] प्रोवाइडर ने इसे मना किया: { $reason }
}
error-model-declined = { $model } ने इसे लिखने से मना कर दिया। संदेश बदलें, या कोई दूसरा मॉडल चुनें।
error-model-sees-no-pictures = { $model } तस्वीरें नहीं देख सकता, इसलिए कोई तस्वीर नहीं लेता। तस्वीरें भेजने के लिए ऐसा मॉडल चुनें जो तस्वीरें देख सके।
error-card-trashed = किरदार ट्रैश में है; पहले उसे रीस्टोर करें।
error-lorebook-trashed = लोरबुक “{ $name }” ट्रैश में है; इस्तेमाल करने के लिए उसे रीस्टोर करें।
error-own-lorebook-flags = किसी किरदार की अपनी लोरबुक किरदार के साथ जाती है: उसे अकेले न स्टार किया जा सकता है, न आर्काइव, न ट्रैश में भेजा जा सकता है और न हर चैट में इस्तेमाल किया जा सकता है।

## फ़ोल्डर और फ़ाइलें

error-no-such-folder = इस कंप्यूटर पर { $folder } नाम का कोई फ़ोल्डर नहीं है।
error-folder-not-chosen = पहले एक फ़ोल्डर चुनें।
error-drive-root-to-watch = ड्राइव के रूट में नज़र रखने के लिए बहुत कुछ है; उसके अंदर का कोई फ़ोल्डर चुनें।
error-drive-root-for-model = किसी ड्राइव के रूट में AI को देने के लिए बहुत कुछ है; उसके अंदर का कोई फ़ोल्डर चुनें।
error-data-folder = उस फ़ोल्डर में Cardwave का अपना डेटा है, या वह उसके अंदर है; कोई दूसरा चुनें।
error-commands-windows-only = कमांड सिर्फ़ Windows पर चलती हैं।
error-recycle-bin-windows-only = फ़ाइलें सिर्फ़ Windows पर रीसायकल बिन में जाती हैं।
error-files-tool-off = पहले सेटिंग्स › टूल में “फ़ाइलें” चालू करें: टीम उसी से टास्क के फ़ोल्डर को पढ़ती और लिखती है।

## तस्वीरें, जवाब और आवाज़ें

error-picture-words-missing = पहले बताएँ कि तस्वीर में क्या दिखे।
error-picture-words-too-long = तस्वीर में क्या दिखे, यह { $most } अक्षरों से लंबा है।
error-picture-needs-words = बताएँ कि तस्वीर में क्या दिखे।
error-goal-missing = बताएँ कि टीम को क्या करना है।
error-dictation-not-set-up = वॉइस टाइपिंग सेट अप नहीं है: सेटिंग्स › मॉडल › वॉइस टाइपिंग।
error-direction-without-go-on = संकेत सिर्फ़ जारी रखें के साथ काम करता है।
error-again-or-go-on = जवाब या तो फिर से लिखा जाता है या जारी रखा जाता है, दोनों नहीं।
error-again-not-reply = सिर्फ़ किसी किरदार का जवाब फिर से लिखा जा सकता है।
error-no-reply-to-write-again = चैट में फिर से लिखने के लिए कोई जवाब नहीं है।
error-no-text = AI ने कोई टेक्स्ट नहीं भेजा। फिर कोशिश करें।
error-worker-no-answer = हेल्पर मॉडल ने कोई जवाब नहीं दिया।
error-unknown-voice = “{ $voice }” नाम की कोई आवाज़ नहीं है।
error-nothing-to-read = पढ़ने के लिए कुछ नहीं है।
error-voice-not-downloaded = आवाज़ डाउनलोड नहीं की गई है।
error-voice-failed = पढ़कर सुनाना नहीं हो पाया। फिर से कोशिश करें।
error-stopping = Cardwave बंद हो रहा है।
error-download-failed = डाउनलोड नहीं हो पाया। कनेक्शन जाँचें और फिर से कोशिश करें।
error-search-model-failed = सर्च मॉडल नहीं चल पाया। Cardwave थोड़ी देर में फिर से कोशिश करेगा।
error-models-not-listed = प्रोवाइडर के मॉडल की सूची नहीं मिल पाई। पता और कुंजी जांचें, फिर दोबारा कोशिश करें।
error-file-not-imported = फ़ाइल पढ़ी नहीं जा सकी: Cardwave इसका फ़ॉर्मैट नहीं जानता।
error-describing-failed = हेल्पर मॉडल किरदार का विवरण नहीं लिख सका।

## किसी हिस्से की विफलताओं के प्रकार: हर एक अपने शब्द `what` (या `whose`) से चुनता है, यानी जिस चीज़ के बारे में है

error-needed = { $what ->
    [persona_name] पर्सोना का नाम होना चाहिए।
    [account_name] अकाउंट का नाम होना चाहिए।
    [card_title] किरदार को एक शीर्षक चाहिए।
    [character_name] किरदार का नाम होना चाहिए।
    [chat_character] चैट में एक किरदार होना चाहिए।
    [chat_title] चैट के शीर्षक में शब्द होने चाहिए।
    [entry_name] एंट्री का नाम होना चाहिए।
    [expression_files] एक zip फ़ाइल (पैक किया हुआ फ़ोल्डर) या किसी सेट की तस्वीरें चुनें।
    [language] भाषा नहीं दी गई।
    [lorebook_name] लोरबुक का नाम होना चाहिए।
    [memory_text] याद में टेक्स्ट होना चाहिए।
    [message_to_improve] बेहतर करने के लिए कोई मैसेज नहीं है।
    [model_name] मॉडल का नाम देना ज़रूरी है।
    [models_folder] पहले मॉडल का एक फ़ोल्डर चुनें।
    [password] पासवर्ड खाली नहीं हो सकता।
    [preset_name] प्रीसेट का नाम होना चाहिए।
    [rewrite_given] कुछ ज़रूरी चीज़ नहीं है। फिर कोशिश करें।
    [summary] सारांश में शब्द होने चाहिए।
    [text_to_change] बदलने के लिए कोई टेक्स्ट नहीं है।
    [text_to_read] पढ़ने के लिए कुछ नहीं है।
    [voice_name] आवाज़ का नाम होना चाहिए।
   *[other] कुछ ज़रूरी चीज़ नहीं है। फिर कोशिश करें।
}
error-too-long = { $what ->
    [account_name] अकाउंट के नाम में ज़्यादा से ज़्यादा { $name_limit } अक्षर होते हैं।
    [chat_title] चैट के शीर्षक में ज़्यादा से ज़्यादा { $title_limit } अक्षर होते हैं।
    [document] { $name } बहुत लंबा है: डॉक्यूमेंट में ज़्यादा से ज़्यादा 20,00,000 अक्षर होते हैं।
    [entry_name] एंट्री के नाम में ज़्यादा से ज़्यादा { $max_name } अक्षर होते हैं।
    [field_name] फ़ील्ड के नाम में 1 से { $max_field } चिह्न होते हैं।
    [lorebook_name] लोरबुक के नाम में ज़्यादा से ज़्यादा { $max_name } अक्षर होते हैं।
    [memory_text] याद में ज़्यादा से ज़्यादा { $text_limit } अक्षर होते हैं।
    [persona_name] पर्सोना के नाम में ज़्यादा से ज़्यादा { $max_name } अक्षर होते हैं।
    [provider_name] नाम में ज़्यादा से ज़्यादा { $name_limit } अक्षर होते हैं।
    [unsaved_text] बिना सेव किया टेक्स्ट ज़्यादा से ज़्यादा { $max_text } चिह्न रखता है।
    [voice_name] आवाज़ के नाम में ज़्यादा से ज़्यादा { $name_most } अक्षर होते हैं।
   *[other] यह { $most } अक्षरों से लंबा है।
}
error-out-of-range = { $what ->
    [authors_note_depth] नोट एक या उससे ज़्यादा मैसेज पीछे रखा जाता है।
    [companion_size] साथी का आकार स्क्रीन की ऊँचाई के { $start } से { $end } प्रतिशत तक होता है।
    [context_size] कॉन्टेक्स्ट का आकार कम से कम 512 टोकन होना चाहिए।
    [entry_chance] एंट्री की संभावना ज़्यादा से ज़्यादा 100 प्रतिशत होती है।
    [provider_setting] { $name } { $min } से { $max } तक होना चाहिए।
    [reply_length] जवाब की लंबाई 1 से { $most_reply_length } टोकन तक होनी चाहिए।
    [slider] स्लाइडर 0 से 100 तक जाता है।
    [talk_pause] रुकना 0 से { $most_talk_pause } सेकंड तक होना चाहिए।
    [talk_replies] लगातार जवाब 1 से { $most_talk_replies } तक होने चाहिए।
    [talkativeness] बातूनीपन 0 से 100 तक होता है।
    [voice_speed] गति { $start }% से { $end }% तक होती है।
   *[other] यह { $least } से { $most } तक होना चाहिए।
}
error-taken = { $what ->
    [card_in_library] पहले से आपकी लाइब्रेरी में है।
    [account_name] एक दूसरे अकाउंट का नाम “{ $name }” है।
    [card_language] कार्ड पहले से { $name } में है।
    [chat_character] { $name } पहले से इस चैट में है।
    [chat_character_twice] { $name } इस चैट में दो बार है।
    [lorebook_same_name] कार्ड में अब इसी नाम की एक लोरबुक या एंट्री है।
    [model_file] { $name } पहले से फ़ोल्डर में है।
    [preset_name] एक दूसरे प्रीसेट का नाम “{ $name }” है।
    [tool_name] { $name } नाम का टूल पहले से है; कोई दूसरा नाम चुनें।
   *[other] यह पहले से मौजूद है।
}
error-in-trash = { $what ->
    [card] किरदार ट्रैश में है; पहले उसे रीस्टोर करें।
